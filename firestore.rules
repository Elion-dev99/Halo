rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOrgMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgCreator(orgId) {
      return signedIn()
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy
          == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if isSelf(uid);
    }

    match /organizations/{orgId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.currency == 'JPY';

      allow read: if isOrgMember(orgId) || isOrgCreator(orgId);
      allow update, delete: if isOrgMember(orgId);

      match /members/{memberId} {
        allow read: if isOrgMember(orgId) || request.auth.uid == memberId;
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.role == 'owner';
        allow update, delete: if isOrgMember(orgId);
      }

      match /accounts/{accountId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /periods/{periodId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /journals/{journalId} {
        allow read, write: if isOrgMember(orgId);

        match /lines/{lineId} {
          allow read, write: if isOrgMember(orgId);
        }
      }

      match /meta/{docId} {
        allow read, write: if isOrgMember(orgId);
      }
    }
  }
}
